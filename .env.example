# Local runs only (`python bot.py`). For Docker, edit compose.yaml instead.

DISCORD_TOKEN=your_discord_bot_token
CRAFTY_BASE_URL=https://your-crafty-host:8443
CRAFTY_API_TOKEN=your_crafty_api_jwt

# Optional fallback login when no API token is set
CRAFTY_USERNAME=
CRAFTY_PASSWORD=
CRAFTY_TOTP=

CRAFTY_VERIFY_SSL=false
DEFAULT_SERVER_ID=your_crafty_server_uuid

# If SERVER_IP is set, /ip answers from here without calling Crafty
SERVER_IP=
SERVER_PORT=
PUBLIC_IP=

MAP_URL=https://map.example.com/
SERVER_VERSION=your_minecraft_version

# /stop and /restart require both IDs; empty means disabled
STOP_RESTART_GUILD_ID=your_discord_guild_id
STOP_RESTART_ROLE_ID=your_discord_role_id

# Optional: register slash commands instantly in one guild
TEST_GUILD_ID=
