# Used for local runs (`python bot.py`). For Docker, edit the `environment` block in compose.yaml instead.

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# (Optional) Discord server ID for instant slash-command registration.
# Leave empty to register globally (can take up to an hour to appear).
TEST_GUILD_ID=

# --- Crafty ---
# Crafty API URL, e.g. https://10.0.0.5:8443 or http://127.0.0.1:8000
# When running the bot in Docker with Crafty on the same host, use:
#   http://host.docker.internal:8443   (127.0.0.1 inside the container is the container itself)
CRAFTY_BASE_URL=https://127.0.0.1:8443

# RECOMMENDED: API token (JWT) from the Crafty panel.
# See "Get a Crafty API token" in README.md. With this set, no username/password
# is needed and the bot never calls /api/v2/auth/login.
CRAFTY_API_TOKEN=

# (Fallback) Only fill these in if you have no API token and want the bot to log in.
# If CRAFTY_API_TOKEN is set, these can be left empty.
CRAFTY_USERNAME=
CRAFTY_PASSWORD=
CRAFTY_TOTP=

# Crafty usually uses a self-signed cert, so keep this false unless you have a valid cert.
CRAFTY_VERIFY_SSL=false

# REQUIRED: ID/UUID of the single server all slash commands target.
DEFAULT_SERVER_ID=your_server_uuid_here

# (Optional) Public IP of the machine running Crafty.
# Used when server_ip in Crafty is 127.0.0.1 or a private IP.
PUBLIC_IP=

# --- Map ---
# Web map URL (BlueMap / dynmap / ...) used by /map
MAP_URL=https://map.example.com/
